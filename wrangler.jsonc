  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expense-manager2",
      "database_id": "23836278-3ac6-4ea7-ac61-422ee027d83f"
    }
  ],
  "vars": {
    "SPREADSHEET_ID": "1Me9loF1LmHtVmJBwtfcGcU3cLb_Nhz4pezxp09q3_gY"
  }
}
