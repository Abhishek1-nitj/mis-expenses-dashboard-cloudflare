{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mis-expenses-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_D1_DATABASE_NAME",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "SPREADSHEET_ID": "1Me9loF1LmHtVmJBwtfcGcU3cLb_Nhz4pezxp09q3_gY"
  }
}
